// UniSahel SaaS - Complete Database Schema
// Multi-tenant university management platform for African institutions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN_INSTITUTION
  RECTORAT
  SCOLARITE
  FACULTE
  DEPARTEMENT
  ENSEIGNANT
  RESPONSABLE_FILIERE
  JURY
  CAISSE
  ETUDIANT
  ETUDIANT_SANTE
  MAITRE_STAGE
  PARENT
}

// ============================================
// MULTI-TENANT CORE
// ============================================

model Tenant {
  id               String    @id @default(cuid())
  name             String
  shortName        String?
  slug             String    @unique
  logo             String?
  stamp            String?
  motto            String?
  address          String?
  city             String?
  country          String?
  phone            String?
  email            String?
  website          String?
  ministry         String?
  rectorName       String?
  rectorTitle      String?
  academicSystem   String    @default("LMD")
  matriculeFormat  String?   @default("UNSH-{YEAR}-{LEVEL}-{SEQ}")
  loginFormat      String?   @default("UNSH-{YEAR}-{LEVEL}-{SEQ}")
  isActive         Boolean   @default(true)
  subscriptionPlan String    @default("STARTER")
  subscriptionEnd  DateTime?
  settings         TenantSettings?
  campuses         Campus[]
  faculties        Faculty[]
  institutes       Institute[]
  departments      Department[]
  domains          Domain[]
  programs         Program[]
  academicYears    AcademicYear[]
  users            User[]
  students         Student[]
  teachers         Teacher[]
  gradingRules     GradingRule[]
  compensationRules CompensationRule[]
  documentTemplates DocumentTemplate[]
  feeStructures    FeeStructure[]
  hospitals        Hospital[]
  clinicalSites    ClinicalSite[]
  announcements    Announcement[]
  auditLogs        AuditLog[]
  importLogs       ImportLog[]
  exportLogs       ExportLog[]
  scholarships     Scholarship[]
  alumni           Alumni[]
  reports          Report[]
  scheduledReports ScheduledReport[]
  attendances      Attendance[]
  onlineExams      OnlineExam[]
  communications   Communication[]
  internships        Internship[]
  internshipPartners InternshipPartner[]
  staff              Staff[]
  leaveRequests      LeaveRequest[]
  rooms              Room[]
  roomReservations   RoomReservation[]
  notifications      Notification[]
  libraryResources   LibraryResource[]
  libraryLoans       LibraryLoan[]
  libraryRooms       LibraryRoom[]
  transportVehicles  TransportVehicle[]
  transportRoutes    TransportRoute[]
  transportDepartures TransportDeparture[]
  transportMaintenances TransportMaintenance[]
  transportAlerts    TransportAlert[]
  transportSubscriptions TransportSubscription[]
  advisors           Advisor[]
  advisingAppointments AdvisingAppointment[]
  advisingWorkshops  AdvisingWorkshop[]
  examBankQuestions  ExamBankQuestion[]
  examResults        ExamResult[]
  examIncidents      ExamIncident[]
  scheduledExams     ScheduledExam[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model TenantSettings {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultLanguage       String   @default("fr")
  supportedLanguages    String   @default("fr,en,ar")
  gradingScale          Float    @default(20.0)
  passingGrade          Float    @default(10.0)
  eliminationGrade      Float    @default(0.0)
  compensationEnabled   Boolean  @default(true)
  catchUpSessionEnabled Boolean  @default(true)
  ccWeight              Float    @default(0.4)
  examWeight            Float    @default(0.6)
  tpWeight              Float    @default(0.0)
  stageWeight           Float    @default(0.0)
  creditsPerSemester    Int      @default(30)
  creditsPerYear        Int      @default(60)
  maxAbsencesAllowed    Int      @default(3)
  pinLength             Int      @default(4)
  studentAuthMode       String   @default("LOGIN_PIN")
  emailVerification     Boolean  @default(true)
  twoFactorEnabled      Boolean  @default(false)
  documentAutoSign      Boolean  @default(false)
  receiptPrefix         String   @default("REC")
  matriculePrefix       String   @default("UNSH")
  allowMobileMoney      Boolean  @default(true)
  allowBankPayment      Boolean  @default(true)
  allowCashPayment      Boolean  @default(true)
  smsNotifications      Boolean  @default(false)
  emailNotifications    Boolean  @default(true)
  whatsappNotifications Boolean  @default(false)
  pwaEnabled            Boolean  @default(false)
  offlineMode           Boolean  @default(false)
  pedagogicalRegistrationOpen Boolean @default(true)
  primaryColor          String   @default("#1a2744")
  secondaryColor        String   @default("#2d7a4f")
  accentColor           String   @default("#c9a84c")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ============================================
// ORGANIZATIONAL STRUCTURE
// ============================================

model Campus {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  city      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faculty {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  shortName   String?
  deanName    String?
  deanTitle   String?
  isActive    Boolean      @default(true)
  departments Department[]
  programs    Program[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Institute {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  shortName     String?
  directorName  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Department {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facultyId  String?
  faculty    Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  name       String
  shortName  String?
  headName   String?
  isActive   Boolean   @default(true)
  teachers   Teacher[]
  programs   Program[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Domain {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  mentions  Mention[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mention {
  id         String     @id @default(cuid())
  domainId   String
  domain     Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  name       String
  code       String?
  specialties Specialty[]
  programs   Program[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Specialty {
  id        String   @id @default(cuid())
  mentionId String
  mention   Mention  @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  tracks    Track[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Track {
  id          String    @id @default(cuid())
  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Program {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facultyId    String?
  faculty      Faculty?   @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  mentionId    String?
  mention      Mention?   @relation(fields: [mentionId], references: [id], onDelete: SetNull)
  name         String
  code         String?
  cycle        String     @default("LICENCE")
  diplomaType  String?
  duration     Int        @default(3)
  isActive     Boolean    @default(true)
  levels       Level[]
  students     Student[]
  admissions   Admission[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Level {
  id           String   @id @default(cuid())
  programId    String
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name         String
  code         String?
  orderIndex   Int      @default(0)
  isActive     Boolean  @default(true)
  semesters    Semester[]
  students     Student[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Semester {
  id            String         @id @default(cuid())
  levelId       String
  level         Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  orderIndex    Int            @default(0)
  teachingUnits TeachingUnit[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model TeachingUnit {
  id                       String                    @id @default(cuid())
  semesterId               String
  semester                 Semester                  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  code                     String?
  name                     String
  credits                  Int                       @default(0)
  type                     String                    @default("FONDAMENTALE")
  compensable              Boolean                   @default(true)
  eliminationGrade         Float?
  responsibleId            String?
  responsible              Teacher?                  @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  orderIndex               Int                       @default(0)
  courseElements           CourseElement[]
  grades                   Grade[]
  pedagogicalRegistrations PedagogicalRegistration[]
  scheduledExams           ScheduledExam[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model CourseElement {
  id             String       @id @default(cuid())
  teachingUnitId String
  teachingUnit   TeachingUnit @relation(fields: [teachingUnitId], references: [id], onDelete: Cascade)
  code           String?
  name           String
  coefficient    Float        @default(1.0)
  hoursCM        Float        @default(0)
  hoursTD        Float        @default(0)
  hoursTP        Float        @default(0)
  hoursStage     Float        @default(0)
  hoursPersonal  Float        @default(0)
  teacherId      String?
  teacher        Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  orderIndex     Int          @default(0)
  grades         Grade[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ============================================
// ACADEMIC YEARS & PERIODS
// ============================================

model AcademicYear {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean   @default(false)
  isCurrent       Boolean   @default(false)
  sessions        ExamSession[]
  admissions      Admission[]
  registrations   AdministrativeRegistration[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ExamSession {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  type           String       @default("NORMALE")
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String?   @unique
  passwordHash        String?
  login               String?   @unique
  pinHash             String?
  firstName           String
  lastName            String
  middleName          String?
  phone               String?
  photo               String?
  role                UserRole  @default(ETUDIANT)
  isActive            Boolean   @default(true)
  emailVerified       Boolean   @default(false)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  mustChangePassword  Boolean   @default(false)
  teacher             Teacher?
  student             Student?
  auditLogs           AuditLog[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId, email])
  @@index([tenantId, login])
}

// ============================================
// TEACHERS
// ============================================

model Teacher {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String?         @unique
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employeeId       String?
  grade            String?
  specialization   String?
  maxHoursPerWeek  Int             @default(20)
  currentHours     Int             @default(0)
  isActive         Boolean         @default(true)
  responsibleUnits TeachingUnit[]
  assignedElements CourseElement[]
  gradeImports     GradeImport[]
  evaluations      ClinicalEvaluation[]
  advisorProfile   Advisor?
  scheduledExams   ScheduledExam[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// ============================================
// STUDENTS
// ============================================

model Student {
  id                   String    @id @default(cuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId               String?   @unique
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  matricule            String?   @unique
  enrollmentNumber     Int?
  firstName            String
  lastName             String
  middleName           String?
  dateOfBirth          DateTime?
  placeOfBirth         String?
  gender               String?
  nationality          String?
  phone                String?
  email                String?
  address              String?
  photo                String?
  guardianName         String?
  guardianPhone        String?
  bacSeries            String?
  bacYear              Int?
  bacNumber            String?
  highSchool           String?
  previousDiploma      String?
  status               String    @default("PRE_INSCRIT")
  currentLevelId       String?
  currentLevel         Level?    @relation(fields: [currentLevelId], references: [id], onDelete: SetNull)
  currentProgramId     String?
  currentProgram       Program?  @relation(fields: [currentProgramId], references: [id], onDelete: SetNull)
  totalCreditsAcquired Int       @default(0)
  registrations        AdministrativeRegistration[]
  pedagogicalRegistrations PedagogicalRegistration[]
  grades               Grade[]
  absences             Absence[]
  payments             Payment[]
  documents            OfficialDocument[]
  admissions           Admission[]
  clinicalInternships  ClinicalInternship[]
  clinicalSkills       StudentClinicalSkill[]
  clinicalAttendances  ClinicalAttendance[]
  guardDuties          GuardDuty[]
  libraryLoans         LibraryLoan[]
  transportSubscriptions TransportSubscription[]
  advisingAppointments AdvisingAppointment[]
  workshopEnrollments  AdvisingWorkshopEnrollment[]
  examResults          ExamResult[]
  examIncidents        ExamIncident[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ============================================
// CANDIDATURES & ADMISSIONS
// ============================================

model AdmissionCampaign {
  id             String     @id @default(cuid())
  tenantId       String
  name           String
  programId      String?
  levelId        String?
  academicYearId String?
  startDate      DateTime
  endDate        DateTime
  status         String     @default("DRAFT")
  maxCandidates  Int?
  conditions     String?
  admissions     Admission[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Admission {
  id                 String              @id @default(cuid())
  tenantId           String
  academicYearId     String
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentId          String?
  student            Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  campaignId         String?
  campaign           AdmissionCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  programId          String?
  program            Program?            @relation(fields: [programId], references: [id], onDelete: SetNull)
  levelId            String?
  // Denormalized level label (not a relation) - a candidature record should
  // keep the level name it was submitted for even if the Level is renamed
  // or removed later.
  niveau             String?
  numero             String?
  type               String              @default("Premiere_inscription")
  candidateFirstName String?
  candidateLastName  String?
  candidateEmail     String?
  candidatePhone     String?
  bacSeries          String?
  bacYear            Int?
  bacAverage         Float?
  documents          String?
  status             String              @default("PENDING")
  rank               Int?
  score              Float?
  decisionDate       DateTime?
  decisionComment    String?
  transformedToStudent Boolean            @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// ============================================
// REGISTRATIONS
// ============================================

model AdministrativeRegistration {
  id                String      @id @default(cuid())
  tenantId          String
  studentId         String
  student           Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId    String
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  programId         String
  levelId           String
  registrationDate  DateTime    @default(now())
  status            String      @default("PRE_INSCRIT")
  paymentStatus     String      @default("UNPAID")
  documentsSubmitted String?
  receiptNumber     String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model PedagogicalRegistration {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teachingUnitId String
  teachingUnit   TeachingUnit @relation(fields: [teachingUnitId], references: [id], onDelete: Cascade)
  academicYearId String
  type           String       @default("OBLIGATOIRE")
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, teachingUnitId, academicYearId])
}

// ============================================
// GRADING SYSTEM
// ============================================

model GradingRule {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  gradingScale          Float    @default(20.0)
  passingGrade          Float    @default(10.0)
  eliminationGrade      Float    @default(0.0)
  compensationEnabled   Boolean  @default(true)
  catchUpSessionEnabled Boolean  @default(true)
  ccWeight              Float    @default(0.4)
  examWeight            Float    @default(0.6)
  tpWeight              Float    @default(0.0)
  stageWeight           Float    @default(0.0)
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CompensationRule {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  type            String   @default("INTRA_UE")
  minAverage      Float    @default(10.0)
  maxCompensation Float    @default(2.0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Grade {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teachingUnitId  String?
  teachingUnit    TeachingUnit? @relation(fields: [teachingUnitId], references: [id], onDelete: Cascade)
  courseElementId String?
  courseElement   CourseElement? @relation(fields: [courseElementId], references: [id], onDelete: Cascade)
  academicYearId  String
  session         String        @default("NORMALE")
  ccGrade         Float?
  examGrade       Float?
  tpGrade         Float?
  stageGrade      Float?
  oralGrade       Float?
  memoireGrade    Float?
  projectGrade    Float?
  finalGrade      Float?
  isAbsent        Boolean       @default(false)
  isJustified     Boolean       @default(false)
  isDefaillant    Boolean       @default(false)
  isLocked        Boolean       @default(false)
  comment         String?
  enteredBy       String?
  validatedBy     String?
  lockedBy        String?
  changeLogs      GradeChangeLog[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model GradeImport {
  id          String   @id @default(cuid())
  tenantId    String
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  fileName    String
  status      String   @default("PENDING")
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  errorRows   Int      @default(0)
  errors      String?
  items       GradeImportItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GradeImportItem {
  id               String      @id @default(cuid())
  importId         String
  import           GradeImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  gradeId          String?
  rowNumber        Int
  studentMatricule String?
  studentName      String?
  rawGrade         Float?
  status           String      @default("PENDING")
  errorMessage     String?
  createdAt        DateTime    @default(now())
}

model GradeChangeLog {
  id        String   @id @default(cuid())
  gradeId   String
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  reason    String
  changedBy String
  changedAt DateTime @default(now())
}

// ============================================
// DELIBERATION
// ============================================

model Deliberation {
  id             String                 @id @default(cuid())
  tenantId       String
  academicYearId String
  programId      String?
  levelId        String?
  type           String                 @default("ANNUEL")
  name           String
  date           DateTime
  status         String                 @default("PREPARATION")
  presidentId    String?
  decisions      DeliberationDecision[]
  isLocked       Boolean                @default(false)
  lockedBy       String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model DeliberationDecision {
  id                String       @id @default(cuid())
  deliberationId    String
  deliberation      Deliberation @relation(fields: [deliberationId], references: [id], onDelete: Cascade)
  studentId         String
  decision          String       @default("AJOURNE")
  average           Float?
  creditsAcquired   Int          @default(0)
  comment           String?
  isModified        Boolean      @default(false)
  modificationReason String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ============================================
// ABSENCES
// ============================================

model Absence {
  id                   String   @id @default(cuid())
  tenantId             String
  studentId            String
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date                 DateTime
  courseId             String?
  reason               String?
  isJustified          Boolean  @default(false)
  justificationDocument String?
  reportedBy           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ============================================
// PAYMENTS & FINANCE
// ============================================

model FeeStructure {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String?
  programId      String?
  levelId        String?
  name           String
  type           String   @default("SCOLARITE")
  amount         Float
  currency       String   @default("FCFA")
  isMandatory    Boolean  @default(true)
  allowTranche   Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id                  String   @id @default(cuid())
  tenantId            String
  studentId           String
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId      String
  amount              Float
  currency            String   @default("FCFA")
  paymentMethod       String   @default("CASH")
  mobileMoneyProvider String?
  transactionRef      String?
  receiptNumber       String?
  receiptDocumentId   String?
