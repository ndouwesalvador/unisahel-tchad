  departure     String
  arrival       String
  distanceKm    Float?
  durationLabel String?
  stops         String[]
  frequency     String?
  vehicles      TransportVehicle[]
  departures    TransportDeparture[]
  subscriptions TransportSubscription[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([tenantId])
  @@map("transport_routes")
}

model TransportDeparture {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleId     String
  vehicle       TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  routeId       String
  route         TransportRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  departureTime String // "06:00"
  label         String? // Aller, Retour
  status        String           @default("a_l_heure") // a_l_heure, en_retard, annule, complet
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId])
  @@map("transport_departures")
}

model TransportMaintenance {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleId   String
  vehicle     TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String
  cost        Float            @default(0)
  performedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())

  @@index([tenantId])
  @@map("transport_maintenances")
}

model TransportAlert {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  severity  String            @default("info") // critique, avertissement, info
  message   String
  createdAt DateTime          @default(now())

  @@index([tenantId])
  @@map("transport_alerts")
}

model TransportSubscription {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routeId   String
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  startDate DateTime       @default(now())
  endDate   DateTime?
  status    String         @default("actif") // actif, expire, suspendu
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([tenantId])
  @@map("transport_subscriptions")
}

// ============================================
// ADVISING (conseil pedagogique)
// ============================================

model Advisor {
  id           String                 @id @default(cuid())
  tenantId     String
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId    String?                @unique
  teacher      Teacher?               @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  name         String
  title        String?
  department   String?
  specialties  String[]
  availability String                 @default("Libre") // Libre, Occupe, En RDV
  appointments AdvisingAppointment[]
  workshops    AdvisingWorkshop[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([tenantId])
  @@map("advisors")
}

model AdvisingAppointment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  advisorId   String
  advisor     Advisor  @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  type        String   @default("Suivi pedagogique") // Orientation, Suivi pedagogique, Projet professionnel, Reorientation, Probleme personnel
  scheduledAt DateTime
  status      String   @default("Planifie") // Planifie, En cours, Termine, Annule
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("advising_appointments")
}

model AdvisingWorkshop {
  id          String                        @id @default(cuid())
  tenantId    String
  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  room        String?
  scheduledAt DateTime
  duration    String?
  capacity    Int                           @default(30)
  advisorId   String?
  advisor     Advisor?                      @relation(fields: [advisorId], references: [id], onDelete: SetNull)
  enrollments AdvisingWorkshopEnrollment[]
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([tenantId])
  @@map("advising_workshops")
}

model AdvisingWorkshopEnrollment {
  id         String           @id @default(cuid())
  tenantId   String
  workshopId String
  workshop   AdvisingWorkshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([workshopId, studentId])
  @@index([tenantId])
  @@map("advising_workshop_enrollments")
}
