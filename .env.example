# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.

# ─── Database (Postgres — Neon in production) ──────────────────────────────
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (unpooled) connection, used by Prisma Migrate/CLI. On Neon this is
# the same host without the "-pooler" suffix.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Auth (NextAuth) ────────────────────────────────────────────────────────
# Required in production - the app throws on startup if this is unset in
# production rather than falling back to an insecure default. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-real-32+-character-secret"
# Only needed if NEXTAUTH_URL can't be inferred from VERCEL_URL (e.g. running
# behind a custom domain, or outside Vercel).
# NEXTAUTH_URL="https://your-domain.example"

# ─── Public app URL ─────────────────────────────────────────────────────────
# Used to build absolute links (e.g. the QR-code verification URL embedded in
# generated documents). Falls back to VERCEL_URL, then localhost:3000, if
# unset - only set this explicitly if that fallback isn't correct for you.
# NEXT_PUBLIC_APP_URL="https://your-domain.example"

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Without this, email sending (e.g. payment receipt confirmations) degrades
# to a logged no-op instead of failing - see src/lib/email.ts.
# RESEND_API_KEY="re_..."

# ─── Set automatically by Vercel — do not set these yourself ───────────────
# VERCEL_URL
# NODE_ENV

# ─── Provisioned but not yet wired to any code ─────────────────────────────
# Present in the Vercel project's env vars but unused in src/ as of this
# writing - kept here as a placeholder in case a future SEED_SECRET-based
# gate is added for /api/seed (currently restricted to SUPER_ADMIN instead).
# SEED_SECRET=""

# ─── Not yet configured (Chantier 4, blocked pending real accounts) ───────
# Mobile Money (Airtel/Orange/MTN/Moov) - no provider is configured; the
# related endpoints in api/payments/route.ts return 501 MOBILE_MONEY_NOT_CONFIGURED.
# AIRTEL_MONEY_API_KEY=""
# ORANGE_MONEY_API_KEY=""
# MTN_MOMO_API_KEY=""
# MOOV_MONEY_API_KEY=""
